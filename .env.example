# App
APP_NAME=career-navigator-backend
ENVIRONMENT=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# CORS / Docs
ALLOW_ORIGINS=http://localhost:3000
DOCS_ENABLED=true

# Postgres (Supabase)
# IMPORTANT:
# - For Supabase, use the "Database Settings" host (e.g. db.<ref>.supabase.co)
# - Ensure your runtime environment has outbound network access to the internet on port 5432.
POSTGRES_HOST=db.your-project-ref.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password

# SQLAlchemy tuning
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Security (placeholder; set real values for non-local)
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
