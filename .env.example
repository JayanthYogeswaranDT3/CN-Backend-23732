# App
APP_NAME="Career Navigator Backend"
APP_ENV="local"  # local|staging|production
APP_VERSION="0.1.0"
LOG_LEVEL="INFO"  # DEBUG|INFO|WARNING|ERROR

# HTTP server
HOST="0.0.0.0"
PORT="8000"

# Database (SQLAlchemy async URL)
# Example: postgresql+asyncpg://postgres:postgres@db:5432/career_navigator
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/career_navigator"

# Security
# IMPORTANT: change in non-local environments
SECRET_KEY="change-me"
ACCESS_TOKEN_EXPIRE_MINUTES="60"

# CORS
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173"]'
"
